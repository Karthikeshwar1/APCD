{
  "description": "APCD: one-time nudge to keep Progress current after real code changes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apcd-hook.sh", "mark"], "async": true, "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apcd-hook.sh", "stop"], "timeout": 5 }
        ]
      }
    ]
  }
}
